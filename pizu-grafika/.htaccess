# PizuGrafika — Apache config for shared hosting

<IfModule mod_rewrite.c>
  RewriteEngine On
  # The path copy stays on pizu.pl; unknown hosts keep the original canonical host.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^(?:www\.)?pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://pizu.pl/grafika/$1 [R=301,L]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} !^pizu\.pl\.?(?::[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ https://grafika.pizu.pl/$1 [R=301,L]
  # Images shared to the installed app (manifest share_target) are a POST to /udostepnij, which
  # the service worker answers. Should one reach the server (no service worker yet), open the
  # app instead of the 404 page.
  RewriteCond %{REQUEST_METHOD} =POST
  RewriteRule ^udostepnij/?$ /grafika/ [R=303,L]
</IfModule>

AddType application/javascript .mjs
AddType application/wasm .wasm
# Installable website (scripts/pwa.mjs)
AddType application/manifest+json .webmanifest

# Wrong addresses get the Pizu 404 page (404.html, copied from pizu-pl/shell by
# scripts/sync-shell.mjs there) instead of the hosting's generic error page.
# Root-relative, so it works under any path; the status stays 404.
ErrorDocument 404 /grafika/404.html

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|wasm|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The service worker decides which version visitors run: never from a cache (browsers mostly
  # skip the HTTP cache for it anyway). The manifest: name and icons of installed apps.
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers on every response
  # HSTS only over HTTPS (browsers ignore it over http, which is redirected above
  # anyway). No includeSubDomains/preload: cPanel also has mail., webmail. etc.
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # Own browsing context group: a page that opens this one (or that this one opens)
  # gets no window handle to it. Nothing here uses cross-origin popups.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # The page's CSP: scripts/deploy.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and they compile WebAssembly. The same goes
  # for sw.js; the page's worker-src 'self' lets it register, and default-src 'self' covers the manifest.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
