# PizuGrafika — Apache config for shared hosting

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

AddType application/javascript .mjs
AddType application/wasm .wasm

<IfModule mod_headers.c>
  # index.html must always revalidate, or a redeploy white-screens cached visitors
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Vite-hashed assets are immutable — cache aggressively
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|mjs|css|wasm|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers on every response
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  # The page's CSP: scripts/deploy.mjs fills in the policy from index.html's
  # <meta> plus frame-ancestors (a <meta> can't carry it). Only on HTML —
  # workers take their CSP from their own response, and they compile WebAssembly.
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'"
  </FilesMatch>
</IfModule>
